CREATE TABLE quiz_attempts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    questions TEXT,
    answers TEXT,
    evaluation TEXT,
    FOREIGN KEY (user_id) REFERENCES users(id)
);
