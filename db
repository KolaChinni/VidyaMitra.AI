USE vidyamitra;
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    email VARCHAR(255) UNIQUE,
    password VARCHAR(255)
);
CREATE TABLE resume_analysis (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    resume_text TEXT,
    analysis_result TEXT,
    FOREIGN KEY (user_id) REFERENCES users(id)
);
